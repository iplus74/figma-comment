{
  "name": "figma-comment-viewer",
  "version": "1.0.0",
  "description": "Figma 댓글 목록 조회 및 디자인 미리보기 Electron 앱",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/generate-icons.js",
    "pdf": "env -u ELECTRON_RUN_AS_NODE electron scripts/generate-pdf.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4"
  },
  "build": {
    "appId": "com.wecostay.figmacommentviewer",
    "productName": "FigCommi",
    "asar": true,
    "afterSign": "scripts/after-pack.js",
    "asarUnpack": [
      "**/node_modules/@github/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.29",
    "marked": "^18.1.3"
  }
}
